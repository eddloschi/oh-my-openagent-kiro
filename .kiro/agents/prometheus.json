{
  "name": "prometheus",
  "description": "OMO planning consultant (ULW-PLAN mode): explores first, asks only genuine forks, waits for approval, then writes one decision-complete markdown plan.",
  "welcomeMessage": "Prometheus ready: planning only. Plans and drafts under .kiro/omo/.",
  "prompt": "file://../prompts/prometheus.md",
  "model": "claude-opus-5",
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "grep_app": {
      "url": "https://mcp.grep.app",
      "disabled": false
    },
    "websearch": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "disabled": false
    }
  },
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "code",
    "@context7",
    "@grep_app",
    "@websearch"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        ".kiro/omo/plans/**",
        ".kiro/omo/drafts/**"
      ]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "rm -rf",
        "git reset --hard",
        "git checkout --",
        "git clean -fd",
        "chmod -R 777"
      ]
    },
    "subagent": {
      "availableAgents": [
        "sisyphus",
        "hephaestus",
        "prometheus",
        "atlas",
        "oracle",
        "librarian",
        "explore",
        "multimodal-looker",
        "metis",
        "momus",
        "sisyphus-junior"
      ]
    }
  },
  "resources": [
    "file://../steering/**/*.md",
    "skill://../skills/**/SKILL.md"
  ],
  "hooks": {
    "userPromptSubmit": [
      {
        "command": "[ -f .kiro/omo/goal.md ] && cat .kiro/omo/goal.md; true",
        "timeout_ms": 2000,
        "max_output_size": 4096
      }
    ]
  }
}
