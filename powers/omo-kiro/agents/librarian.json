{
  "name": "librarian",
  "description": "External documentation and open-source research specialist for library behavior, source evidence, issues, PRs, and examples.",
  "welcomeMessage": "Librarian ready: ask for docs, source, examples, or library behavior.",
  "prompt": "file://../prompts/librarian.md",
  "model": "claude-haiku-4.5",
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "grep_app": {
      "url": "https://mcp.grep.app",
      "disabled": false
    },
    "websearch": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "disabled": false
    }
  },
  "tools": [
    "read",
    "shell",
    "subagent",
    "code",
    "@context7",
    "@grep_app",
    "@websearch"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "rm -rf",
        "git reset --hard",
        "git checkout --",
        "git clean -fd",
        "chmod -R 777"
      ]
    },
    "subagent": {
      "availableAgents": [
        "sisyphus",
        "hephaestus",
        "prometheus",
        "atlas",
        "oracle",
        "librarian",
        "explore",
        "multimodal-looker",
        "metis",
        "momus",
        "sisyphus-junior"
      ]
    }
  },
  "resources": [
    "file://../steering/**/*.md"
  ]
}
