{
  "name": "atlas",
  "description": "OMO plan executor and start-work worker: goal + task registration, notepads, boulder state, per-task DoneClaim verification, and PR delivery modes.",
  "welcomeMessage": "Atlas ready: executing saved plans from .kiro/omo/plans/ with verification evidence.",
  "prompt": "file://../prompts/atlas.md",
  "model": "claude-sonnet-5",
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "disabled": false
    },
    "grep_app": {
      "url": "https://mcp.grep.app",
      "disabled": false
    },
    "websearch": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
      "disabled": false
    }
  },
  "tools": [
    "read",
    "write",
    "shell",
    "subagent",
    "code",
    "@context7",
    "@grep_app",
    "@websearch"
  ],
  "allowedTools": [
    "read"
  ],
  "toolsSettings": {
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "rm -rf",
        "git reset --hard",
        "git checkout --",
        "git clean -fd",
        "chmod -R 777"
      ]
    },
    "subagent": {
      "availableAgents": [
        "sisyphus",
        "hephaestus",
        "prometheus",
        "atlas",
        "oracle",
        "librarian",
        "explore",
        "multimodal-looker",
        "metis",
        "momus",
        "sisyphus-junior"
      ]
    }
  },
  "resources": [
    "file://../steering/**/*.md",
    "skill://../skills/**/SKILL.md"
  ],
  "hooks": {
    "agentSpawn": [
      {
        "command": "[ -f .kiro/omo/boulder.json ] && cat .kiro/omo/boulder.json; true",
        "timeout_ms": 2000,
        "max_output_size": 4096
      }
    ],
    "userPromptSubmit": [
      {
        "command": "[ -f .kiro/omo/goal.md ] && cat .kiro/omo/goal.md; true",
        "timeout_ms": 2000,
        "max_output_size": 4096
      }
    ]
  }
}
